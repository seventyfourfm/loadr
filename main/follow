local function getTargetCharacter()
    if TargetPlayerName == "" then return nil end
    
    -- Try exact match first
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Name == TargetPlayerName or player.DisplayName == TargetPlayerName then
            return player.Character
        end
    end
    
    -- Then try partial match
    local lowerTarget = string.lower(TargetPlayerName)
    for _, player in ipairs(Players:GetPlayers()) do
        if string.find(string.lower(player.Name), lowerTarget, 1, true) or 
           string.find(string.lower(player.DisplayName), lowerTarget, 1, true) then
            return player.Character
        end
    end
    return nil
end

-- Check if we have line of sight
local function hasLineOfSight(startPos, endPos)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character}
    
    local direction = (endPos - startPos)
    local distance = direction.Magnitude
    if distance <= 1 then return true end
    
    local result = workspace:Raycast(startPos, direction, rayParams)
    return result == nil
end

-- FIXED: Better path following with smooth movement
local waypointIndex = 1
local currentPath = nil
local lastTargetPos = Vector3.new()
local pathRefreshTimer = 0

local function followPath(path, targetPos)
    if not path or path.Status ~= Enum.PathStatus.Success then
        return false
    end
    
    local waypoints = path:GetWaypoints()
    if #waypoints == 0 then return false end
    
    local myChar = LocalPlayer.Character
    if not myChar then return false end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myRoot or not myHum then return false end
    
    -- Reset waypoint index if target moved significantly
    local myPos = myRoot.Position
    if (lastTargetPos - targetPos).Magnitude > 5 then
        waypointIndex = 1
        lastTargetPos = targetPos
    end
    
    -- Find the furthest visible waypoint
    local bestIndex = 1
    for i = 1, #waypoints do
        local wp = waypoints[i]
        if hasLineOfSight(myPos, wp.Position) then
            bestIndex = i
        else
            break
        end
    end
    
    -- Move to the best waypoint
    if bestIndex <= #waypoints then
        local targetWp = waypoints[bestIndex]
        local distanceToWp = (myPos - targetWp.Position).Magnitude
        
        -- If we're close to the waypoint, move to the next one
        if distanceToWp < 3 and bestIndex < #waypoints then
            bestIndex = bestIndex + 1
            targetWp = waypoints[bestIndex]
        end
        
        -- Move to the waypoint
        myHum:MoveTo(targetWp.Position)
        
        -- Jump if needed
        if targetWp.Action == Enum.PathWaypointAction.Jump then
            myHum.Jump = true
        end
        
        -- Check if we need to jump for elevation
        if targetWp.Position.Y - myPos.Y > 2 then
            myHum.Jump = true
        end
        
        waypointIndex = bestIndex
        return true
    end
    
    return false
end

-- Track and execute movement
local lastPosition = Vector3.new()
local stuckTimer = 0

local function trackAndExecute(targetChar)
    local myChar = LocalPlayer.Character
    if not myChar or not targetChar then return false end
    
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    
    if not myRoot or not myHum or not targetRoot then return false end
    
    -- Check if target is valid
    if targetChar:GetAttribute("Health") and targetChar:GetAttribute("Health") <= 0 then
        return false
    end
    
    local myPos = myRoot.Position
    local targetPos = targetRoot.Position
    local distance = (myPos - targetPos).Magnitude
    
    -- Update speed label
    local speed = (myPos - lastPosition).Magnitude / 0.1
    SpeedLabel.Text = "Speed: " .. string.format("%.1f", speed)
    lastPosition = myPos
    
    -- Stop if very close
    if distance < 3 then 
        myHum:Move(Vector3.new(0, 0, 0))
        StatusLabel.Text = "Status: Close enough"
        return true
    end
    
    -- Stuck detection
    local currentSpeed = (myPos - lastPosition).Magnitude
    if currentSpeed < 0.3 and distance > 5 then
        stuckTimer = stuckTimer + 0.1
        if stuckTimer > 1.5 then
            -- Jump and move randomly to get unstuck
            myHum.Jump = true
            local randomDir = Vector3.new(math.random(-10, 10), 0, math.random(-10, 10)).Unit
            myHum:MoveTo(myPos + randomDir * 5)
            stuckTimer = 0
            StatusLabel.Text = "Status: Unstucking..."
            return true
        end
    else
        stuckTimer = math.max(0, stuckTimer - 0.05)
    end
    
    -- Check line of sight
    if hasLineOfSight(myPos, targetPos) then
        myHum:MoveTo(targetPos)
        
        -- Jump if target is above us
        if targetPos.Y - myPos.Y > 2 then
            myHum.Jump = true
        end
        
        StatusLabel.Text = "Status: Direct path"
        currentPath = nil -- Reset path cache
        return true
    end
    
    -- Recompute path if needed
    pathRefreshTimer = pathRefreshTimer + 0.1
    if not currentPath or pathRefreshTimer > 0.5 or (lastTargetPos - targetPos).Magnitude > 3 then
        local path = PathfindingService:CreatePath(AgentParams)
        local success, err = pcall(function()
            path:ComputeAsync(myPos, targetPos)
        end)
        
        if success and path.Status == Enum.PathStatus.Success then
            currentPath = path
            waypointIndex = 1
            lastTargetPos = targetPos
            StatusLabel.Text = "Status: Path found"
        else
            -- Fallback direct movement
            myHum:MoveTo(targetPos)
            StatusLabel.Text = "Status: No path, direct"
            return true
        end
        pathRefreshTimer = 0
    end
    
    -- Follow the cached path
    if currentPath then
        return followPath(currentPath, targetPos)
    end
    
    -- Ultimate fallback
    myHum:MoveTo(targetPos)
    return true
end

