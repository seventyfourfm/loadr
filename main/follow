-- Main execution thread
task.spawn(function()
    while true do
        task.wait(0.1)
        pcall(function()
            if FollowBotActive then
                local targetChar = getTargetCharacter()
                if targetChar then
                    local success = trackAndExecute(targetChar)
                    if not success then
                        StatusLabel.Text = "Status: Target not reachable"
                    end
                else
                    -- Stop moving if target not found
                    local myChar = LocalPlayer.Character
                    if myChar then
                        local myHum = myChar:FindFirstChildOfClass("Humanoid")
                        if myHum then 
                            myHum:Move(Vector3.new(0, 0, 0))
                        end
                    end
                    StatusLabel.Text = "Status: Target not found"
                    currentPath = nil
                end
            end
        end)
    end
end)

